{
  "name": "speedrunners-mods",
  "productName": "SpeedRunners Mods",
  "version": "0.1.0",
  "description": "A native-feeling macOS launcher for SpeedRunners and Velo.",
  "author": "bentrd",
  "license": "MIT",
  "main": "src/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bentrd/SpeedRunnersMods.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "xnb": "1.3.0-a"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.bentrd.speedrunnersmods",
    "productName": "SpeedRunners Mods",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "docs/THIRD-PARTY.md",
      "docs/licenses/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/port",
        "to": "port"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "zip",
        "dmg"
      ],
      "identity": null,
      "artifactName": "SpeedRunners-Mods-${version}-${arch}.${ext}",
      "icon": "resources/SpeedRunners.icns"
    },
    "publish": null,
    "afterPack": "tools/sign-app.cjs",
    "asarUnpack": [
      "node_modules/xnb/**/*"
    ]
  }
}
